rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Moderasyon (ücretsiz plan: bulut fonksiyonu yok, yetki kurallarla) ----
    // Moderatör: eski özel yetki (moderation_admin) ya da Firebase konsolundan açılan zd_moderators/{uid} kaydı.
    function isMod() {
      return request.auth != null
        && (request.auth.token.get('moderation_admin', false) == true
            || exists(/databases/$(database)/documents/zd_moderators/$(request.auth.uid)));
    }
    // Susturulan kullanıcı süresi bitene kadar gönderi/yanıt yazamaz.
    function notMuted() {
      let p = /databases/$(database)/documents/social_mutes/$(request.auth.uid);
      return !exists(p) || get(p).data.until < request.time.toMillis();
    }
    function modKeys() { return ['status','report_count','moderated_by','moderated_at']; }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /devices/{deviceId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && deviceId.matches('[a-f0-9]{64}')
          && request.resource.data.keys().hasAll(['token','platform','session_id','updated_at'])
          && request.resource.data.keys().hasOnly(['token','platform','session_id','updated_at'])
          && request.resource.data.token is string && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform == 'android'
          && request.resource.data.session_id is string && request.resource.data.session_id.size() == 36
          && request.resource.data.updated_at == request.time;
      }
      // Exclude devices here: overlapping allows would bypass its field validation.
      match /{collection}/{document=**} {
        // Verification belongs only to the server attestation, never a private backup flag.
        function verificationFields() {
          return ['verified','approved','attested','verified_sale','verification_status',
            'evidence_status','verified_at','verified_by','approved_at','approved_by','attestation_id'];
        }
        function owner() { return collection != 'devices' && request.auth != null && request.auth.uid == uid; }
        allow read, delete: if owner();
        allow create: if owner() && !request.resource.data.keys().hasAny(verificationFields());
        allow update: if owner()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(verificationFields());
      }
    }
    match /social_posts/{postId} {
      // Meydan gönderisi. Tek istemci yazarı SocialCloudRepository.publishLocalPost; aynı belgeye
      // merge ile yazdığı için aynı istek ilk seferde create, sonra update kuralına düşer.
      // Alanlar yalnızca yazıldıklarında doğrulanır; eski belgelerdeki dokunulmayan alanlar
      // (photo_uri, media_urls gibi) okunmaya devam eder ve güncellemeyi engellemez.
      function postFields() {
        return ['cloud_id','user_id','user_name','province','district','neighborhood','garden_name',
                'variety','post_type','content','is_real_sale','sale_grade','sale_kg','sale_price',
                'created_at','updated_at','is_active','status','report_count','moderated_by','moderated_at'];
      }
      function postTypes() {
        return ['GENERAL','QUESTION','GARDEN','PEST','IRRIGATION','FERTILIZER','SPRAY','HARVEST','MARKET','SALE'];
      }
      // Görünen ad doğrulanmış oturum belgesinden gelir; istemci başka bir ad yazamaz.
      function postAuthorName() {
        let name = request.auth.token.get('name', '');
        return (name is string && name.size() > 0) ? name : 'Üretici';
      }
      // İstemci saati ile sunucu saati arasındaki küçük farka 10 dakika tolerans.
      function notInFuture(value) {
        return value is int && value > 0 && value <= request.time.toMillis() + 600000;
      }
      function shortText(value, max) { return value is string && value.size() <= max; }
      function validPostFields(d, keys) {
        return (!('user_name' in keys) || d.user_name == postAuthorName())
          && (!('content' in keys) || (d.content is string && d.content.size() <= 5000
                                       && d.content.matches('[\\s\\S]*[^\\s][\\s\\S]*')))
          && (!('post_type' in keys) || d.post_type in postTypes())
          && (!('province' in keys) || shortText(d.province, 100))
          && (!('district' in keys) || shortText(d.district, 100))
          && (!('neighborhood' in keys) || shortText(d.neighborhood, 100))
          && (!('garden_name' in keys) || shortText(d.garden_name, 200))
          && (!('variety' in keys) || shortText(d.variety, 100))
          // Gerçek satış işareti doğrulama gibi görünür; istemci yalnızca 0 yazabilir.
          && (!('is_real_sale' in keys) || d.is_real_sale == 0)
          && (!('sale_grade' in keys) || shortText(d.sale_grade, 20))
          && (!('sale_kg' in keys) || (d.sale_kg is number && d.sale_kg >= 0 && d.sale_kg <= 1000000000))
          && (!('sale_price' in keys) || (d.sale_price is number && d.sale_price >= 0 && d.sale_price <= 10000000))
          && (!('updated_at' in keys) || notInFuture(d.updated_at))
          && (!('is_active' in keys) || d.is_active in [0, 1])
          // Yazar yalnız ilk yazımda durum seçer: yeni üyenin ilk mesajları PENDING (onay bekler).
          && (!('status' in keys) || d.status in ['PENDING', 'ACTIVE'])
          && (!('report_count' in keys) || d.report_count == 0)
          && !('moderated_by' in keys) && !('moderated_at' in keys);
      }
      function postFlag() { return /databases/$(database)/documents/mod_flags/$('P_' + postId)/reporters/$(request.auth.uid); }
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['cloud_id','user_id','user_name','post_type',
                                                            'content','created_at','updated_at'])
                    && request.resource.data.keys().hasOnly(postFields())
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.cloud_id == postId
                    && notInFuture(request.resource.data.created_at)
                    && notMuted()
                    && validPostFields(request.resource.data, request.resource.data.keys());
      allow update: if request.auth != null
                    && resource.data.user_id == request.auth.uid
                    // Moderatörün kaldırdığı gönderiyi sahibi yeniden açamaz ve değiştiremez.
                    && resource.data.get('moderated_by', '') == ''
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(postFields())
                    // Yazar kendi mesajını onaylayamaz, şikâyet sayacını değiştiremez.
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(modKeys())
                    // Sahip hiçbir zaman değişmez; kimlik ve oluşturma zamanı eski belgede yoksa bir kez eklenebilir.
                    && !('user_id' in request.resource.data.diff(resource.data).affectedKeys())
                    && (!('cloud_id' in request.resource.data.diff(resource.data).affectedKeys())
                        || (!('cloud_id' in resource.data) && request.resource.data.cloud_id == postId))
                    && (!('created_at' in request.resource.data.diff(resource.data).affectedKeys())
                        || (!('created_at' in resource.data) && notInFuture(request.resource.data.created_at)))
                    && validPostFields(request.resource.data, request.resource.data.diff(resource.data).affectedKeys());
      // Moderatör: onaylar (ACTIVE, sayaç sıfır) ya da gizler (HIDDEN + moderated_by).
      allow update: if isMod()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(modKeys())
                    && request.resource.data.get('status', 'ACTIVE') in ['ACTIVE', 'HIDDEN']
                    && request.resource.data.get('report_count', 0) is int
                    && request.resource.data.get('moderated_by', request.auth.uid) == request.auth.uid;
      // Şikâyet eden: sayaç tam 1 artar ve aynı toplu yazımda kendi şikâyet kaydı ilk kez oluşur (kişi başı bir kez).
      allow update: if request.auth != null && resource.data.user_id != request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['report_count'])
                    && request.resource.data.report_count == resource.data.get('report_count', 0) + 1
                    && existsAfter(postFlag()) && !exists(postFlag());
      // Delete has no request.resource; checking it used to reject every deletion.
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;

      match /comments/{commentId} {
        function commentFlag() {
          return /databases/$(database)/documents/mod_flags/$('C_' + postId + '_' + commentId)/reporters/$(request.auth.uid);
        }
        function signedIn() { return request.auth != null; }
        // Optional fields preserve legacy root documents without rewriting them.
        function validThreadFields(d) {
          return d.get('parent_comment_id','') is string
            && d.get('parent_comment_id','').size() <= 200
            && d.get('root_comment_id',commentId) is string
            && d.get('root_comment_id',commentId).size() > 0
            && d.get('root_comment_id',commentId).size() <= 200
            && d.get('reply_to_uid','') is string && d.get('reply_to_uid','').size() <= 128
            && d.get('reply_to_name','') is string && d.get('reply_to_name','').size() <= 200;
        }
        function validParent(d) {
          let parentId = d.get('parent_comment_id','');
          return parentId == ''
            ? (d.get('root_comment_id',commentId) == commentId
               && d.get('reply_to_uid','') == '' && d.get('reply_to_name','') == '')
            : (parentId != commentId && parentId.matches('[^/]+')
               && exists(/databases/$(database)/documents/social_posts/$(postId)/comments/$(parentId))
               && matchesParent(d, parentId));
        }
        function matchesParent(d, parentId) {
          let p = get(/databases/$(database)/documents/social_posts/$(postId)/comments/$(parentId)).data;
          return d.get('root_comment_id',commentId) == p.get('root_comment_id',parentId)
            && d.get('reply_to_uid','') == p.user_id
            && d.get('reply_to_name','') == p.user_name;
        }
        function sameThread() {
          let before = resource.data;
          let after = request.resource.data;
          return after.get('parent_comment_id','') == before.get('parent_comment_id','')
            && after.get('root_comment_id',commentId) == before.get('root_comment_id',commentId)
            && after.get('reply_to_uid','') == before.get('reply_to_uid','')
            && after.get('reply_to_name','') == before.get('reply_to_name','');
        }
        function validComment() {
          let d = request.resource.data;
          return d.keys().hasAll(['cloud_id','post_cloud_id','user_id','user_name',
                                  'content','is_active','created_at','updated_at'])
            && d.keys().hasOnly(['cloud_id','post_cloud_id','user_id','user_name',
                                'content','is_active','created_at','updated_at',
                                'parent_comment_id','root_comment_id','reply_to_uid','reply_to_name',
                                'status','report_count','moderated_by','moderated_at'])
            && validThreadFields(d)
            && d.cloud_id == commentId
            && d.post_cloud_id == postId
            && d.user_id == request.auth.uid
            && d.user_name is string && d.user_name.size() > 0 && d.user_name.size() <= 200
            && d.content is string && d.content.size() <= 500
            && d.is_active in [0,1]
            && (d.is_active == 0 || d.content.matches('[\\s\\S]*[^\\s][\\s\\S]*'))
            && d.created_at is int && d.created_at > 0
            && d.updated_at is int && d.updated_at >= 0;
        }
        allow read: if signedIn();
        allow create: if signedIn() && validComment() && validParent(request.resource.data)
          && notMuted()
          && !request.resource.data.keys().hasAny(modKeys())
          && exists(/databases/$(database)/documents/social_posts/$(postId));
        // Soft deletion is a durable tombstone so offline readers learn about it.
        allow update: if signedIn() && resource.data.user_id == request.auth.uid
          && resource.data.get('moderated_by', '') == ''
          && validComment() && sameThread()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(modKeys())
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.created_at == resource.data.created_at;
        allow update: if isMod()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(modKeys())
          && request.resource.data.get('status', 'ACTIVE') in ['ACTIVE', 'HIDDEN']
          && request.resource.data.get('report_count', 0) is int
          && request.resource.data.get('moderated_by', request.auth.uid) == request.auth.uid;
        allow update: if signedIn() && resource.data.user_id != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['report_count'])
          && request.resource.data.report_count == resource.data.get('report_count', 0) + 1
          && existsAfter(commentFlag()) && !exists(commentFlag());
        allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
      }
    }
    // Private client-side visibility preferences. Social content permissions are unchanged.
    match /user_blocks/{blockerUid}/items/{blockedUid} {
      function blockOwner() {
        return request.auth != null && request.auth.uid == blockerUid
          && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
      }
      function validBlock() {
        let d = request.resource.data;
        return d.keys().hasAll(['blocker_uid','blocked_uid','created_at','display_name','region'])
          && d.keys().hasOnly(['blocker_uid','blocked_uid','created_at','display_name','region'])
          && d.blocker_uid == request.auth.uid && d.blocker_uid == blockerUid
          && d.blocked_uid == blockedUid && blockedUid != blockerUid
          && blockedUid.matches('[A-Za-z0-9_-]{1,128}')
          && d.created_at == request.time
          && d.display_name is string && d.display_name.size() <= 200
          && d.region is string && d.region.size() <= 200;
      }
      allow get, list: if blockOwner();
      allow create: if blockOwner() && validBlock();
      allow delete: if blockOwner();
      allow update: if false;
    }

    // Reports are isolated by reporter; individual own-document get supports a transaction.
    // No client may list reports, alter a submitted report, or decide moderation status.
    match /reports/{reporterUid}/items/{reportId} {
      function reportingUser() {
        return request.auth != null && request.auth.uid == reporterUid
          && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
      }
      function reportIdPart(value) {
        return value is string && value.matches('[A-Za-z0-9_-]{1,128}');
      }
      function postOwner(d) {
        let path = /databases/$(database)/documents/social_posts/$(d.post_cloud_id);
        return exists(path) && get(path).data.user_id == d.reported_uid
          && get(path).data.get('is_active', 1) == 1;
      }
      function commentOwner(d) {
        let path = /databases/$(database)/documents/social_posts/$(d.post_cloud_id)/comments/$(d.comment_cloud_id);
        return reportIdPart(d.comment_cloud_id)
          && exists(/databases/$(database)/documents/social_posts/$(d.post_cloud_id))
          && exists(path) && get(path).data.user_id == d.reported_uid
          && get(path).data.get('is_active', 1) == 1
          && (d.target_type == 'USER'
            || (d.target_type == 'COMMENT' && get(path).data.get('parent_comment_id', '') == '')
            || (d.target_type == 'REPLY' && get(path).data.get('parent_comment_id', '') != ''));
      }
      function targetExists(d) {
        return d.target_type == 'USER'
          ? (d.target_id == d.reported_uid && (d.comment_cloud_id == '' ? postOwner(d) : commentOwner(d)))
          : (d.target_type == 'POST'
            ? (d.target_id == d.post_cloud_id && d.comment_cloud_id == '' && postOwner(d))
            : (d.target_id == d.comment_cloud_id && commentOwner(d)));
      }
      function validReport() {
        let d = request.resource.data;
        return d.keys().hasAll(['reporter_uid','reported_uid','target_type','target_id',
                                 'post_cloud_id','comment_cloud_id','reason','created_at','status'])
          && d.keys().hasOnly(['reporter_uid','reported_uid','target_type','target_id',
                              'post_cloud_id','comment_cloud_id','reason','created_at','status'])
          && d.reporter_uid == request.auth.uid && d.reporter_uid == reporterUid
          && reportIdPart(d.reported_uid) && d.reported_uid != request.auth.uid
          && d.target_type in ['POST','COMMENT','REPLY','USER']
          && reportIdPart(d.target_id) && reportIdPart(d.post_cloud_id)
          && d.comment_cloud_id is string
          && d.reason in ['SPAM','ABUSE','MISLEADING','INAPPROPRIATE','FRAUD','OTHER']
          && d.status == 'OPEN' && d.created_at == request.time
          && reportId == d.target_type + '|' + (d.target_type == 'USER' ? '' : d.post_cloud_id) + '|' + d.target_id
          && targetExists(d);
      }
      allow get: if reportingUser();
      allow create: if reportingUser() && validReport();
      allow list, update, delete: if false;
    }

    // Anonymous regional market output is authored only by trusted Cloud Functions.
    // Raw Elek records remain under users/{uid}/... and are never publicly readable.
    match /zeytin_markets/{season} {
      allow read: if request.auth != null;
      allow write: if false;
      match /regions/{regionId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    match /zeytin_market_stats/{statId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // League output is authored only by a trusted Admin SDK publisher.
    // Client-controlled users/{uid}/... backups are NEVER publication authority.
    match /zeytin_leagues/{season} {
      allow read: if request.auth != null;
      allow write: if false;
      match /snapshots/{snapshot} {
        allow read: if request.auth != null;
        allow write: if false;
        match /regions/{region} {
          allow read: if request.auth != null;
          allow write: if false;
        }
        match /members/{uid} {
          allow get: if request.auth != null && request.auth.uid == uid;
          allow list, write: if false;
        }
      }
    }
    // Sohbet "… yazıyor" göstergesi: herkesin tek belgesi; metin yok, yalnız ad, kanal ve bitiş zamanı.
    match /social_typing/{uid} {
      function typingName() {
        let name = request.auth.token.get('name', '');
        return (name is string && name.size() > 0) ? name : 'Üretici';
      }
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['user_id','user_name','post_type','until'])
                    && request.resource.data.keys().hasOnly(['user_id','user_name','post_type','until'])
                    && request.resource.data.user_id == uid
                    && request.resource.data.user_name == typingName()
                    && request.resource.data.post_type is string && request.resource.data.post_type.size() <= 20
                    && request.resource.data.until is int
                    && request.resource.data.until <= request.time.toMillis() + 60000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Moderatör kaydı: yalnız Firebase konsolundan açılır; kişi kendi kaydını okuyabilir (panel görünürlüğü).
    match /zd_moderators/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // Şikâyet kuyruğu: hedef başına bir belge, şikâyet eden başına bir alt kayıt (sayaç kişi başı bir kez artar).
    match /mod_flags/{flagId} {
      function reporterPath() {
        return /databases/$(database)/documents/mod_flags/$(flagId)/reporters/$(request.auth.uid);
      }
      function validFlag(d) {
        return d.keys().hasOnly(['target_type','post_cloud_id','comment_cloud_id','reported_uid','preview',
                                  'count','status','updated_at','last_reason'])
          && d.target_type in ['POST','COMMENT']
          && d.post_cloud_id is string && d.post_cloud_id.matches('[A-Za-z0-9-]{1,128}')
          && d.comment_cloud_id is string && d.comment_cloud_id.size() <= 128
          && flagId == (d.target_type == 'POST' ? 'P_' + d.post_cloud_id
                                                 : 'C_' + d.post_cloud_id + '_' + d.comment_cloud_id)
          && d.reported_uid is string && d.reported_uid.size() <= 128 && d.reported_uid != request.auth.uid
          && d.preview is string && d.preview.size() <= 300
          && d.updated_at is int
          && d.last_reason in ['SPAM','ABUSE','MISLEADING','INAPPROPRIATE','FRAUD','OTHER'];
      }
      allow read: if isMod();
      allow create: if request.auth != null && existsAfter(reporterPath()) && !exists(reporterPath())
        && validFlag(request.resource.data)
        && request.resource.data.count == 1 && request.resource.data.status == 'OPEN';
      allow update: if (request.auth != null && existsAfter(reporterPath()) && !exists(reporterPath())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','status','updated_at','last_reason'])
          && request.resource.data.count == resource.data.count + 1 && request.resource.data.status == 'OPEN'
          && validFlag(request.resource.data))
        || (isMod() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updated_at'])
          && request.resource.data.status in ['OPEN','RESOLVED']);
      allow delete: if isMod();
      match /reporters/{reporterUid} {
        allow get: if request.auth != null && (request.auth.uid == reporterUid || isMod());
        allow list: if isMod();
        allow create: if request.auth != null && request.auth.uid == reporterUid
          && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous'
          && request.resource.data.keys().hasOnly(['created_at','reason'])
          && request.resource.data.created_at == request.time
          && request.resource.data.reason in ['SPAM','ABUSE','MISLEADING','INAPPROPRIATE','FRAUD','OTHER'];
        allow update, delete: if false;
      }
    }
    // Susturma: moderatör yazar; kişi kendi kaydını okuyup "ne zamana kadar" bilgisini görür.
    match /social_mutes/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isMod());
      allow list, delete: if isMod();
      allow create, update: if isMod() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['until','reason','by','created_at','name'])
        && request.resource.data.until is int
        && request.resource.data.by == request.auth.uid
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.created_at is int;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
