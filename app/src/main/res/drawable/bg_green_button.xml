<?xml version="1.0" encoding="utf-8"?>
<!-- Birincil düğme: düz yeşil, koyu yazı, 26dp köşe (elek_save_solid ile aynı). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape android:shape="rectangle"><solid android:color="#1C3340" /><corners android:radius="26dp" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="@color/zd_green_mid" /><corners android:radius="26dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/zd_green" /><corners android:radius="26dp" /></shape></item>
</selector>
