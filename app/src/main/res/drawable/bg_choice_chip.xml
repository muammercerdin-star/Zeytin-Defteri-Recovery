<?xml version="1.0" encoding="utf-8"?>
<!-- Seçilebilir kutu/çip: seçiliyken yeşil çerçeve ve koyu yeşil zemin. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/zd_green_soft" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/zd_green" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/zd_surface" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/zd_border" />
        </shape>
    </item>
</selector>
