<?xml version="1.0" encoding="utf-8"?>
<!-- Yeni kart dili (Ana Sayfa/Bahçelerim/Elek ile aynı): düz kart, 20dp köşe, ince kenar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/zd_card" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/zd_border" />
    <padding
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp" />
</shape>
