<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#887B64" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#03FFFFFF" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#6C614F" />
        </shape>
    </item>
</layer-list>
