<?xml version='1.0' encoding='utf-8'?>
<resources>
    <color name="auth_bg">#0E1C25</color>
    <color name="auth_field">#132732</color>
    <color name="auth_border">#2A4957</color>
    <color name="auth_divider">#22404D</color>
    <color name="auth_green">#3F6B47</color>
    <color name="auth_accent">#9CCB78</color>
    <color name="auth_focus">#7FB35C</color>
    <color name="auth_title">#F2F6F0</color>
    <color name="auth_body">#A3B4BC</color>
    <color name="auth_label">#C6D3D8</color>
    <color name="auth_hint">#8FA3AD</color>
    <string name="auth_brand">Zeytin Defteri</string>
    <string name="auth_register_title">Hesabını oluşturalım</string>
    <string name="auth_login_title">Hoş geldin!</string>
    <string name="auth_register_description">Bahçelerini ve sezon kayıtlarını güvenle saklamak için hesabını oluştur.</string>
    <string name="auth_login_description">Bahçelerine ve kayıtlarına ulaşmak için hesabınla giriş yap.</string>
    <string name="auth_register_tab">Hesap Oluştur</string>
    <string name="auth_login_tab">Giriş Yap</string>
    <string name="auth_google_register">Google ile kayıt ol</string>
    <string name="auth_google_login">Google ile giriş yap</string>
    <string name="auth_email_divider">veya e-posta ile</string>
    <string name="auth_name_label">Ad Soyad</string>
    <string name="auth_email_label">E-posta</string>
    <string name="auth_password_label">Şifre</string>
    <string name="auth_confirm_label">Şifre tekrar</string>
    <string name="auth_name_hint">Örn. Muammer Çerdin</string>
    <string name="auth_email_hint">ornek@eposta.com</string>
    <string name="auth_password_hint">En az 8 karakter</string>
    <string name="auth_login_password_hint">Şifreni yaz</string>
    <string name="auth_confirm_hint">Şifreni tekrar yaz</string>
    <string name="auth_password_rule">En az 8 karakter, bir rakam ve bir büyük harf.</string>
    <string name="auth_password_rejected">Şifre en az 8 karakter, bir rakam ve bir büyük harf içermeli.</string>
    <string name="auth_show_passwords">İki şifre alanını göster</string>
    <string name="auth_hide_passwords">İki şifre alanını gizle</string>
    <string name="auth_terms_ack">Kullanım Koşulları</string>
    <string name="auth_privacy_ack">KVKK Aydınlatma Metni</string>
    <string name="auth_accept_label">Kullanım Koşulları’nı okudum ve kabul ediyorum.</string>
    <string name="auth_terms_open">Kullanım Koşulları belgesini aç</string>
    <string name="auth_privacy_open">KVKK Aydınlatma Metni belgesini aç</string>
    <string name="auth_legal_checkbox">Kullanım Koşulları’nı okudum ve kabul ediyorum</string>
    <string name="auth_legal_missing">Hukuki metinler taslak; onaylanana kadar yeni kayıt kapalı. Mevcut hesabınla giriş yapabilirsin.</string>
    <string name="auth_accept_required">Devam etmek için Kullanım Koşulları’nı kabul ettiğini işaretle.</string>
    <string name="auth_close">Kapat</string>
    <string name="auth_forgot">Şifremi Unuttum</string>
    <string name="auth_register_submit">Hesabımı Oluştur  →</string>
    <string name="auth_login_submit">Giriş Yap  →</string>
    <string name="auth_security">Hesabın ve bahçe kayıtların güvende.</string>
    <style name="AuthLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/auth_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AuthInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/auth_title</item>
        <item name="android:textColorHint">@color/auth_hint</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/auth_input_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AuthTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/auth_body</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AuthLegalLink">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/auth_accent</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>