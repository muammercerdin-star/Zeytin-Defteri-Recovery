<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zd_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/formContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">


        <!-- ================================================= -->
        <!-- ÜST BAR                                           -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/zd_text"
                android:textSize="34sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🫒  Zeytin Defteri"
                android:textColor="@color/zd_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Space
                android:layout_width="44dp"
                android:layout_height="44dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- HERO                                              -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvGardenHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="🌿"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="İlk bahçeni oluşturalım"
            android:textColor="@color/zd_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="18dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Zeytin Defteri bahçelerin üzerinden çalışır.&#10;İlk zeytinliğini kaydederek başlayalım."
            android:textColor="@color/zd_muted"
            android:textSize="13sp" />


        <!-- ================================================= -->
        <!-- BAHÇE ADI                                         -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_search"
                android:gravity="center"
                android:text="🌳"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bahçe adı *"
                    android:textColor="@color/zd_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGardenName"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@android:color/transparent"
                    android:hint="Örn. Girelli Zeytinliği"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/zd_text"
                    android:textColorHint="@color/zd_muted"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- KONUM                                             -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_search"
                    android:gravity="center"
                    android:text="📍"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konum *"
                        android:textColor="@color/zd_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="İl, ilçe ve mahalle / köy seç"
                        android:textColor="@color/zd_muted"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>


            <AutoCompleteTextView
                android:id="@+id/etProvince"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search"
                android:drawableEnd="@drawable/ic_dropdown_arrow"
                android:hint="İl seç..."
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/zd_text"
                android:textColorHint="@color/zd_muted"
                android:textSize="14sp" />

            <AutoCompleteTextView
                android:id="@+id/etDistrict"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:drawableEnd="@drawable/ic_dropdown_arrow"
                android:hint="İlçe seç..."
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/zd_text"
                android:textColorHint="@color/zd_muted"
                android:textSize="14sp" />

            <AutoCompleteTextView
                android:id="@+id/etNeighborhood"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:drawableEnd="@drawable/ic_dropdown_arrow"
                android:hint="Mahalle / köy seç..."
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/zd_text"
                android:textColorHint="@color/zd_muted"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ÇEŞİT                                             -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_search"
                android:gravity="center"
                android:text="🫒"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zeytin çeşidi"
                    android:textColor="@color/zd_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etVariety"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@android:color/transparent"
                    android:hint="Gemlik, Domat, Uslu..."
                    android:inputType="textCapWords"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/zd_text"
                    android:textColorHint="@color/zd_muted"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- AĞAÇ SAYISI + YAŞ                                 -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌳  Ağaç sayısı"
                    android:textColor="@color/zd_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTreeCount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:color/transparent"
                    android:hint="120"
                    android:inputType="number"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/zd_text"
                    android:textColorHint="@color/zd_muted"
                    android:textSize="18sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅  Ağaç yaşı"
                    android:textColor="@color/zd_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGardenAge"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:color/transparent"
                    android:hint="14"
                    android:inputType="number"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/zd_text"
                    android:textColorHint="@color/zd_muted"
                    android:textSize="18sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ALAN                                              -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_search"
                android:gravity="center"
                android:text="📐"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alan"
                    android:textColor="@color/zd_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAreaDecare"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@android:color/transparent"
                    android:hint="Örn. 8,5 dekar"
                    android:inputType="numberDecimal"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/zd_text"
                    android:textColorHint="@color/zd_muted"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SULAMA                                            -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧  Sulama tipi"
                android:textColor="@color/zd_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerIrrigation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FOTOĞRAF                                          -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/btnPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_search"
                android:gravity="center"
                android:text="📷"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bahçe fotoğrafı"
                    android:textColor="@color/zd_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPhotoStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="İsteğe bağlı • Fotoğraf seç"
                    android:textColor="@color/zd_muted"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- NOT                                               -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝  Not"
                android:textColor="@color/zd_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGardenNotes"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:gravity="top|start"
                android:hint="Bahçeyle ilgili eklemek istediğin bir not..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="@color/zd_text"
                android:textColorHint="@color/zd_muted"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- KAYDET                                            -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/btnSaveGarden"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_green_button"
            android:elevation="0dp"
            android:gravity="center"
            android:text="Bahçemi Kaydet"
            android:textColor="@color/zd_bg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:gravity="center"
            android:text="🔒  Bahçe bilgilerin hesabında güvende."
            android:textColor="@color/zd_muted"
            android:textSize="10sp" />

    </LinearLayout>

</ScrollView>