<?xml version="1.0" encoding="utf-8"?>
<!-- Bahçe detayı hızlı eylem kutusu: yeşil disk içinde çizgi ikon + kısa ad. İkon ve ad koddan verilir. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_tile"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:minHeight="76dp"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="10dp"
    android:paddingEnd="2dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_icon_disc">

        <ImageView
            android:id="@+id/tileIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/zd_green" />
    </FrameLayout>

    <TextView
        android:id="@+id/tileLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="@color/zd_text"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
