        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#978868" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="31dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/archiveBadge4" android:layout_width="30dp" android:layout_height="match_parent" android:gravity="center" android:textColor="#10283D" android:textSize="13sp"/><View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" /><TextView android:id="@+id/archiveLabel4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingLeft="8dp" android:fontFamily="serif" android:textColor="#20364A" android:textSize="12sp"/><View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" /><TextView android:id="@+id/archiveGrade4" android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:textColor="#20364A" android:textSize="11sp"/><View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" /><TextView android:id="@+id/archivePrice4" android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:textColor="#0D4DB8" android:textSize="11.5sp" android:textStyle="bold"/><View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" /><TextView android:id="@+id/archiveTotal4" android:layout_width="62dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:textColor="#20364A" android:textSize="11.5sp" android:textStyle="bold"/></LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#978868" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="31dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/archiveBadge5" android:layout_width="30dp" android:layout_height="match_parent" android:gravity="center" android:textColor="#10283D" android:textSize="13sp"/><View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" /><TextView android:id="@+id/archiveLabel5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingLeft="8dp" android:fontFamily="serif" android:textColor="#20364A" android:textSize="12sp"/><View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" /><TextView android:id="@+id/archiveGrade5" android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:textColor="#20364A" android:textSize="11sp"/><View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" /><TextView android:id="@+id/archivePrice5" android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:textColor="#0D4DB8" android:textSize="11.5sp" android:textStyle="bold"/><View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" /><TextView android:id="@+id/archiveTotal5" android:layout_width="62dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:textColor="#20364A" android:textSize="11.5sp" android:textStyle="bold"/></LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#978868" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="#11FFFFFF">
            <TextView android:layout_width="30dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:text="Σ" android:textColor="#10283D" android:textSize="11sp" android:textStyle="bold"/>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingLeft="8dp" android:fontFamily="serif" android:text="TOPLAM" android:textColor="#10283D" android:textSize="12sp" android:textStyle="bold"/>
