            <TextView android:layout_width="30dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:text="No" android:textColor="#10283D" android:textSize="11sp" android:textStyle="bold"/>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:fontFamily="serif" android:text="Elek" android:textColor="#10283D" android:textSize="11sp" android:textStyle="bold"/>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" />
            <TextView android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:text="Kg" android:textColor="#10283D" android:textSize="11sp" android:textStyle="bold"/>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" />
            <TextView android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:text="Fiyat" android:textColor="#10283D" android:textSize="11sp" android:textStyle="bold"/>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" />
            <TextView android:layout_width="62dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:text="Tutar" android:textColor="#10283D" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#978868" />
