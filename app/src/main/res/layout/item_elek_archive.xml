<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/archiveMonthHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="@color/zd_muted"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/archiveRecordCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/elek_archive_row_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/elek_distribution_track"
                android:gravity="center"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/archiveRecordDayNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/zd_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/archiveRecordWeekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/zd_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/archiveRecordGarden"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/zd_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/archiveRecordMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="@color/zd_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/archiveRecordRevenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text=""
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:text="›"
                android:textColor="@color/zd_muted"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Kayda ait sınıf dağılımı: her segment bir elek sınıfı (ağırlık = kg). -->
        <LinearLayout
            android:id="@+id/archiveRecordBar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/elek_distribution_track"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <View android:id="@+id/archiveGrade0" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/elek_badge_double" />
            <View android:id="@+id/archiveGrade1" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/elek_badge_one" />
            <View android:id="@+id/archiveGrade2" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/elek_badge_two" />
            <View android:id="@+id/archiveGrade3" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/elek_badge_three" />
            <View android:id="@+id/archiveGrade4" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/elek_badge_four" />
            <View android:id="@+id/archiveGrade5" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/elek_badge_oil" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
