<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/elek_archive_paper_record"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="12dp"
    android:paddingRight="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_olive" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/archiveRecordGarden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#10283D"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_archive_calendar" />

                <TextView
                    android:id="@+id/archiveRecordDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="serif"
                    android:singleLine="true"
                    android:textColor="#20364A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:text="|"
                    android:textColor="#A39372"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/archiveRecordDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="cursive"
                    android:singleLine="true"
                    android:textColor="#0D4DB8"
                    android:textSize="13sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="104dp"
            android:layout_height="74dp"
            android:background="@drawable/elek_archive_note_tape"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp"
            android:rotation="-2">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="TOPLAM TUTAR"
                android:textColor="#10283D"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/archiveRecordRevenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="cursive"
                android:singleLine="true"
                android:textColor="#0D4DB8"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="72dp"
                android:layout_height="3dp"
                android:layout_marginTop="2dp"
                android:background="#C46F5B" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
