            <TextView android:id="@+id/archiveRecordKg" android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="sans-serif-medium" android:textColor="#0D4DB8" android:textSize="13sp" android:textStyle="bold"/>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" />
            <TextView android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="serif" android:text="—" android:textColor="#8D816A" android:textSize="11sp"/>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#978868" />
            <TextView android:id="@+id/archiveRecordRevenueTable" android:layout_width="62dp" android:layout_height="match_parent" android:gravity="center" android:fontFamily="sans-serif-medium" android:textColor="#0D4DB8" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/elek_archive_paper_summary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <LinearLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/elek_archive_metric_icon_box"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_archive_scale" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Toplam Kg"
                    android:textColor="#20364A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/archiveRecordKgSide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="cursive"
                    android:singleLine="true"
                    android:textColor="#0D4DB8"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

