<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcomeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="22dp">


        <!-- ================================================= -->
        <!-- ÜST BİLGİ ALANI                                   -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">


            <!-- SOL BİLGİ -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_welcome_step"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/zd_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ana Adım"
                    android:textColor="@color/zd_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Üretimden satışa"
                    android:textColor="@color/zd_muted"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- SAĞ BİLGİ -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_welcome_step"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/zd_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tek Defter"
                    android:textColor="@color/zd_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tüm sezon tek yerde"
                    android:textColor="@color/zd_muted"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- HERO GÖRSELİ                                      -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/imgHeroScene"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:adjustViewBounds="true"
            android:contentDescription="Zeytin Defteri tanıtım görseli"
            android:scaleType="fitCenter"
            android:src="@drawable/welcome_hero_scene" />


        <!-- ================================================= -->
        <!-- ANA BAŞLIK                                        -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Zeytin Defteri'ne Hoş Geldin."
            android:textColor="@color/zd_text"
            android:textSize="26sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- AÇIKLAMA                                          -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvSlogan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Bahçeni kaydet, yaptığın işlemleri takip et,\nhasadını ve eleğini kaydet, satışını gör."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- DEKORATİF AYIRICI                                 -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="38dp"
                android:layout_height="1dp"
                android:background="@color/zd_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="🌿"
                android:textSize="15sp" />

            <View
                android:layout_width="38dp"
                android:layout_height="1dp"
                android:background="@color/zd_border" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ALT PANEL                                         -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_welcome_bottom_panel"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="15dp"
            android:paddingBottom="14dp">


            <!-- ================================================= -->
            <!-- GİRİŞ YAP                                         -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Zaten hesabın var mı?  Giriş yap ›"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- ÜCRETSİZ BAŞLA                                    -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_welcome_button"
                android:backgroundTint="@null"
                android:elevation="5dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Ücretsiz Başla   →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- GÜVEN MESAJI                                      -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center"
                android:text="Verilerin güvende. Gizliliğin bizim için önemli."
                android:textColor="@color/zd_muted"
                android:textSize="11sp" />


            <!-- ================================================= -->
            <!-- KULLANIM KOŞULLARI / GİZLİLİK                    -->
            <!-- ClickableSpan Java tarafından atanacak            -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:linksClickable="true"
                android:lineSpacingExtra="1dp"
                android:text="Devam ederek Kullanım Koşulları ve Gizlilik Politikası’nı kabul etmiş olursun."
                android:textColor="@color/zd_muted"
                android:textSize="10sp" />


        </LinearLayout>


    </LinearLayout>

</ScrollView>