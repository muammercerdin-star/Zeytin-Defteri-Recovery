<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zd_bg"
    android:fillViewport="true"
    android:overScrollMode="never">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">


        <!-- ===================================================== -->
        <!-- ÜST BAR                                               -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/zd_text"
                android:textSize="34sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paylaşım Oluştur"
                    android:textColor="@color/zd_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Bölgendeki üreticilerle paylaş"
                    android:textColor="@color/zd_muted"
                    android:textSize="10sp" />


            </LinearLayout>


        </LinearLayout>


        <!-- ===================================================== -->
        <!-- ÜRETİCİ KARTI                                         -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">


            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_soft_circle"
                android:gravity="center"
                android:text="👨‍🌾"
                android:textSize="22sp" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Üretici"
                    android:textColor="@color/zd_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvUserRegion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Konum bilgisi"
                    android:textColor="@color/zd_muted"
                    android:textSize="10sp" />


            </LinearLayout>


        </LinearLayout>


        <!-- ===================================================== -->
        <!-- BAHÇE                                                 -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hangi bahçeden?"
            android:textColor="@color/zd_text"
            android:textSize="12sp"
            android:textStyle="bold" />


        <Spinner
            android:id="@+id/spinnerGarden"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_search"
            android:paddingStart="13dp"
            android:paddingEnd="13dp" />


        <!-- ===================================================== -->
        <!-- PAYLAŞIM TÜRÜ                                        -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Paylaşım türü"
            android:textColor="@color/zd_text"
            android:textSize="12sp"
            android:textStyle="bold" />


        <Spinner
            android:id="@+id/spinnerPostType"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_search"
            android:paddingStart="13dp"
            android:paddingEnd="13dp" />


        <!-- ===================================================== -->
        <!-- İÇERİK                                                -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Ne paylaşmak istiyorsun?"
            android:textColor="@color/zd_text"
            android:textSize="12sp"
            android:textStyle="bold" />


        <EditText
            android:id="@+id/etPostContent"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_card"
            android:gravity="top|start"
            android:hint="Örneğin: Bu sabah zeytin sineği tuzaklarında hareketlilik gördüm. Bölgede durum nasıl?"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="15dp"
            android:textColor="@color/zd_text"
            android:textColorHint="@color/zd_muted"
            android:textSize="13sp" />


        <!-- ===================================================== -->
        <!-- MEDYA EKLEME                                         -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/btnAddPhoto"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">


            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_soft_circle"
                android:gravity="center"
                android:text="📷"
                android:textSize="21sp" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvAddMediaTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fotoğraf / video ekle"
                    android:textColor="@color/zd_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvAddMediaSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="En fazla 6 medya • 1 video"
                    android:textColor="@color/zd_muted"
                    android:textSize="10sp" />


            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/zd_muted"
                android:textSize="28sp"
                android:textStyle="bold" />


        </LinearLayout>


        <!-- ===================================================== -->
        <!-- SEÇİLEN MEDYA BİLGİSİ                                -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvSelectedMediaInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:textColor="@color/zd_muted"
            android:textSize="10sp"
            android:visibility="gone" />


        <!-- ===================================================== -->
        <!-- MEDYA ÖNİZLEME                                       -->
        <!-- ===================================================== -->

        <ImageView
            android:id="@+id/imgPostPreview"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_card"
            android:contentDescription="Paylaşım medyası"
            android:scaleType="centerCrop"
            android:visibility="gone" />


        <!-- ===================================================== -->
        <!-- BİLGİ                                                -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/zd_surface"
            android:orientation="horizontal"
            android:padding="12dp">


            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="🌿"
                android:textSize="18sp" />


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="Paylaşımlar üretici topluluğuna yardımcı olmak için kullanılır. Yanıltıcı fiyat, satış veya hastalık bilgileri paylaşma."
                android:textColor="@color/zd_muted"
                android:textSize="10sp" />


        </LinearLayout>


        <!-- ===================================================== -->
        <!-- PAYLAŞ                                               -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/btnPublish"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_green_button"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Paylaş   →"
            android:textColor="@color/zd_bg"
            android:textSize="15sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Paylaşımını daha sonra profilinden yönetebilirsin."
            android:textColor="@color/zd_muted"
            android:textSize="9sp" />


    </LinearLayout>


</ScrollView>