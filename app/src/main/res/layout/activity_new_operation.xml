<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zd_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="22dp"
        android:paddingBottom="46dp">


        <!-- ================================================= -->
        <!-- ÜST BAR -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_soft_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/zd_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Yeni İşlem"
                    android:textColor="@color/zd_text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Bahçende yaptığın işi kaydet"
                    android:textColor="@color/zd_muted"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FORM KARTI -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">


            <!-- BAHÇE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bahçe *"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerGarden"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_search"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />


            <!-- İŞLEM TÜRÜ -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:text="İşlem Türü *"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerType"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_search"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />


            <!-- TARİH -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:text="Tarih *"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_search"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:gravity="center_vertical"
                android:hint="Tarih seç"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/zd_text"
                android:textColorHint="@color/zd_muted"
                android:textSize="16sp" />


            <!-- MİKTAR -->

            <TextView
                android:id="@+id/tvQuantityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:text="Miktar"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etQuantity"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="Örn. 150"
                    android:inputType="numberDecimal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:singleLine="true"
                    android:textColor="@color/zd_text"
                    android:textColorHint="@color/zd_muted"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinnerUnit"
                    android:layout_width="120dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_search"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp" />

            </LinearLayout>


            <!-- MASRAF -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:text="Masraf"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCost"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_search"
                android:hint="Örn. 2.400 TL"
                android:inputType="numberDecimal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/zd_text"
                android:textColorHint="@color/zd_muted"
                android:textSize="16sp" />


            <!-- NOT -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:text="Açıklama / Not"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_search"
                android:gravity="top|start"
                android:hint="Örn. MKP 0-52-34 verildi, ağaç başına 150 gram..."
                android:inputType="textMultiLine"
                android:padding="18dp"
                android:textColor="@color/zd_text"
                android:textColorHint="@color/zd_muted"
                android:textSize="15sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BİLGİ -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/cardOperationHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_market"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/tvOperationHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💧 Sulamada miktarı litre, m³ veya çalışma süresi olarak kaydedebilirsin."
                android:textColor="@color/zd_muted"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- KAYDET -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/btnSaveOperation"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_green_button"
            android:clickable="true"
            android:elevation="5dp"
            android:focusable="true"
            android:gravity="center"
            android:text="İşlemi Kaydet"
            android:textColor="@color/zd_bg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:gravity="center"
            android:text="Hasat ve satış kayıtları kendi özel ekranlarından yapılır."
            android:textColor="@color/zd_muted"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>