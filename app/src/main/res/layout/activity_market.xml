<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zd_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="22dp"
        android:paddingBottom="50dp">


        <!-- ÜST BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_soft_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/zd_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Zeytin Piyasası"
                    android:textColor="@color/zd_text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Gerçek satışlardan oluşan bölgesel piyasa"
                    android:textColor="@color/zd_muted"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- FİLTRELER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔎  Piyasa Filtresi"
                android:textColor="@color/zd_text"
                android:textSize="19sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Elek"
                android:textColor="@color/zd_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerGrade"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_search"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Dönem"
                android:textColor="@color/zd_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerPeriod"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_search"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Zeytin Çeşidi"
                android:textColor="@color/zd_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etVarietyFilter"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_search"
                android:hint="Tümü veya Domat, Gemlik..."
                android:inputType="textCapWords"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/zd_text"
                android:textColorHint="@color/zd_muted" />

        </LinearLayout>


        <!-- GENEL PİYASA -->

        <LinearLayout
            android:id="@+id/cardMarketSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_market"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvSelectedMarket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 No Piyasası"
                android:textColor="@color/zd_text"
                android:textSize="20sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medyan Fiyat"
                        android:textColor="@color/zd_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvMedianPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="—"
                        android:textColor="@color/zd_text"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fiyat Aralığı"
                        android:textColor="@color/zd_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvPriceRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="—"
                        android:textColor="@color/zd_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="15dp"
                android:background="@color/zd_surface" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Satış Hacmi"
                        android:textColor="@color/zd_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvMarketKg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 kg"
                        android:textColor="@color/zd_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gerçek Satış"
                        android:textColor="@color/zd_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTransactionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 kayıt"
                        android:textColor="@color/zd_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <TextView
                android:id="@+id/tvConfidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Veri bekleniyor"
                android:textColor="@color/zd_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOutlierInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Aykırı fiyat filtresi aktif"
                android:textColor="@color/zd_muted"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- BÖLGELER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍  Bölgelere Göre"
                android:textColor="@color/zd_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bölgeler medyan satış fiyatına göre sıralanır."
                android:textColor="@color/zd_muted"
                android:textSize="12sp" />


            <LinearLayout
                android:id="@+id/containerRegions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmptyMarket"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:gravity="center"
                    android:text="Bu filtre için henüz gerçek satış kaydı yok"
                    android:textColor="@color/zd_muted"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- VERİ KAYNAĞI -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_market"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛡️ Piyasa nasıl hesaplanıyor?"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Yalnızca gerçekleşen ve piyasa kullanımına izin verilen satışlar kullanılır. Fiyat teklifleri dahil edilmez. Aykırı fiyatlar IQR filtresiyle hesaptan çıkarılır ve düz ortalama yerine medyan gösterilir."
                android:textColor="@color/zd_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDataSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Şimdilik bu cihazdaki satış kayıtları kullanılıyor."
                android:textColor="@color/zd_muted"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- SATIŞ EKLE -->

        <TextView
            android:id="@+id/btnAddSale"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_green_button"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="+ Gerçek Satış Kaydet"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>