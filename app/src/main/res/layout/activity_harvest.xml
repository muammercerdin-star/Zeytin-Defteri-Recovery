<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zd_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="22dp"
        android:paddingBottom="48dp">


        <!-- ================================================= -->
        <!-- ÜST BAR -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_soft_circle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/zd_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Hasat Kaydı"
                    android:textColor="@color/zd_text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Elek sonucunu ve hasat değerini kaydet"
                    android:textColor="@color/zd_muted"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BAHÇE + TARİH -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bahçe *"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerGarden"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_search"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Hasat Tarihi *"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etHarvestDate"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_search"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/zd_text"
                android:textSize="16sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FİYAT BİLGİSİ -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_market"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fiyatlar değiştirilebilir"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Son kullandığın fiyatlar otomatik önerilir. Bugünkü fiyat farklıysa değiştirebilirsin. Eski hasat kayıtlarının fiyatı değişmez."
                android:textColor="@color/zd_muted"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ELEK SONUCU -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elek Sonucu"
                android:textColor="@color/zd_text"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- ================= DOUBLE ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:text="Double"
                android:textColor="@color/zd_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etKgDouble"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="Kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etPriceDouble"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="TL/kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvValueDouble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="end"
                android:text="Değer: 0 TL"
                android:textColor="@color/zd_muted"
                android:textSize="13sp"
                android:textStyle="bold" />


            <!-- ================= 1 NO ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="1 No"
                android:textColor="@color/zd_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etKg1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="Kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etPrice1"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="TL/kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvValue1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="end"
                android:text="Değer: 0 TL"
                android:textColor="@color/zd_muted"
                android:textSize="13sp"
                android:textStyle="bold" />


            <!-- ================= 2 NO ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="2 No"
                android:textColor="@color/zd_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etKg2"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="Kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etPrice2"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="TL/kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvValue2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="end"
                android:text="Değer: 0 TL"
                android:textColor="@color/zd_muted"
                android:textSize="13sp"
                android:textStyle="bold" />


            <!-- ================= 3 NO ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="3 No"
                android:textColor="@color/zd_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etKg3"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="Kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etPrice3"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="TL/kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvValue3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="end"
                android:text="Değer: 0 TL"
                android:textColor="@color/zd_muted"
                android:textSize="13sp"
                android:textStyle="bold" />


            <!-- ================= 4 NO ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="4 No"
                android:textColor="@color/zd_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etKg4"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="Kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etPrice4"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="TL/kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvValue4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="end"
                android:text="Değer: 0 TL"
                android:textColor="@color/zd_muted"
                android:textSize="13sp"
                android:textStyle="bold" />


            <!-- ================= YAĞLIK ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Yağlık"
                android:textColor="@color/zd_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etKgOil"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="Kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etPriceOil"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:hint="TL/kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvValueOil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="end"
                android:text="Değer: 0 TL"
                android:textColor="@color/zd_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- TOPLAM -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_market"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hasat Özeti"
                android:textColor="@color/zd_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toplam Hasat"
                        android:textColor="@color/zd_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTotalKg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 kg"
                        android:textColor="@color/zd_text"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tahmini Değer"
                        android:textColor="@color/zd_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTotalValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 TL"
                        android:textColor="@color/zd_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- HASAT MASRAFLARI -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hasat Masrafları"
                android:textColor="@color/zd_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLaborCost"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_search"
                android:hint="İşçilik masrafı (TL)"
                android:inputType="numberDecimal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etTransportCost"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search"
                android:hint="Nakliye masrafı (TL)"
                android:inputType="numberDecimal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etOtherCost"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search"
                android:hint="Diğer hasat masrafları (TL)"
                android:inputType="numberDecimal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvTotalHarvestCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:gravity="end"
                android:text="Toplam hasat masrafı: 0 TL"
                android:textColor="@color/zd_text"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- NOT -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not"
                android:textColor="@color/zd_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etHarvestNote"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:gravity="top|start"
                android:hint="Hasatla ilgili not..."
                android:inputType="textMultiLine"
                android:padding="18dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- KAYDET -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/btnSaveHarvest"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_green_button"
            android:clickable="true"
            android:elevation="5dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Hasadı Kaydet"
            android:textColor="@color/zd_bg"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>