<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zd_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="22dp"
        android:paddingBottom="40dp">


        <!-- ================================================= -->
        <!-- ÜST BAR                                           -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/zd_text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gizlilik Politikası"
                android:textColor="@color/zd_text"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ANA BAŞLIK                                        -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Zeytin Defteri Gizlilik Politikası"
            android:textColor="@color/zd_text"
            android:textSize="24sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- SON GÜNCELLEME                                    -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Son güncelleme: 21 Ağustos 2026"
            android:textColor="@color/zd_muted"
            android:textSize="12sp" />


        <!-- ================================================= -->
        <!-- GİRİŞ                                             -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="Zeytin Defteri olarak kullanıcıların gizliliğine önem veriyoruz. Bu politika; uygulamayı kullanırken hangi bilgilerin işlenebileceğini, bu bilgilerin hangi amaçlarla kullanılabileceğini ve kullanıcıların verileri üzerindeki haklarını açıklamak amacıyla hazırlanmıştır."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 1 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="1. Gizlilik Politikasının Amacı"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Bu Gizlilik Politikası, Zeytin Defteri uygulamasının kullanıcı verilerini hangi amaçlarla işleyebileceğini ve bu verilerin nasıl korunmasının hedeflendiğini açıklamaktadır. Uygulamanın kullanılması sırasında gerekli olan veriler yalnızca hizmetin sunulması, geliştirilmesi, güvenliğinin sağlanması ve kullanıcının tercih ettiği özelliklerin çalıştırılması amacıyla kullanılmalıdır."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 2 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. Toplanabilecek Bilgiler"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Uygulamanın kullanılan özelliklerine bağlı olarak hesap bilgileri, bahçe kayıtları, üretim işlemleri, masraflar, hasat miktarları, elek sonuçları, satış kayıtları, bölge bilgileri ve kullanıcının uygulamaya kendi isteğiyle girdiği diğer bilgiler işlenebilir. Gereksiz kişisel veri toplanmaması temel yaklaşımımızdır."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 3 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Hesap Bilgileri"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Kullanıcı hesabı oluşturulması halinde ad, kullanıcı adı, e-posta adresi, telefon numarası veya uygulamanın hesap sistemi için gerekli olan benzeri bilgiler işlenebilir. Hangi bilgilerin zorunlu olduğu kullanılan kayıt yöntemine göre değişebilir."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 4 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="4. Bahçe ve Üretim Kayıtları"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Kullanıcı; bahçe adı, ağaç sayısı, ağaç yaşı, yapılan bakım işlemleri, sulama, gübreleme, ilaçlama, masraf, hasat, elek ve benzeri üretim bilgilerini uygulamaya kaydedebilir. Bu kayıtlar kullanıcının kendi üretim geçmişini takip edebilmesi, rapor oluşturabilmesi ve sezon performansını değerlendirebilmesi amacıyla kullanılır."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 5 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="5. Konum ve Bölge Bilgileri"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Bahçenin bulunduğu il, ilçe, mahalle veya benzeri bölge bilgileri kullanıcı tarafından seçilebilir veya ilgili özelliklerde kullanıcının izniyle belirlenebilir. Bölge bilgileri; bahçelerin düzenlenmesi, bölgesel raporlar ve piyasa istatistikleri gibi özelliklerin çalışması amacıyla kullanılabilir. Cihazın hassas konumuna erişilmesi gereken bir özellik olması halinde gerekli Android izni ayrıca kullanıcıdan istenir."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 6 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="6. Satış Kayıtları"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Kullanıcı satış yaptığı ürünün miktarını, elek sınıfını, satış fiyatını, tarihini ve ilgili diğer bilgileri kendi kayıtlarını takip etmek amacıyla uygulamaya ekleyebilir. Bu satış kayıtları varsayılan olarak kullanıcının kişisel üretim ve satış geçmişinin bir parçasıdır."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 7 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="7. Piyasa Sisteminde Verilerin Kullanılması"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Kullanıcı piyasa paylaşımına açıkça izin verdiğinde; ürün veya elek sınıfı, satış miktarı, satış fiyatı, tarih, çeşit ve bölge gibi satış bilgileri bölgesel piyasa istatistiklerinin oluşturulmasında kullanılabilir. Piyasa paylaşım izni verilmemiş satış kayıtları kamuya açık piyasa istatistiklerine dahil edilmemelidir. Piyasa sonuçlarının sunulmasında kullanıcının adının veya hesabını doğrudan tanımlayan bilgilerin gösterilmemesi hedeflenir."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 8 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="8. Yanıltıcı ve Aykırı Verilerin Kontrolü"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Piyasa sisteminin güvenilirliğini korumak amacıyla olağan dışı, hatalı veya sistemin genel verilerinden ciddi şekilde ayrılan kayıtlar otomatik veya manuel kontrollerden geçirilebilir. Bu tür kayıtlar piyasa hesaplamalarından hariç tutulabilir. Bu işlemler kullanıcıları doğrudan ifşa etmek amacıyla değil, istatistiklerin güvenilirliğini korumak amacıyla yapılır."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 9 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="9. Verilerin Kullanım Amaçları"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Toplanan veya kullanıcı tarafından girilen bilgiler; uygulama özelliklerinin çalıştırılması, hesap ve bahçe kayıtlarının gösterilmesi, rapor ve hesaplamaların hazırlanması, piyasa istatistiklerinin oluşturulması, güvenliğin sağlanması, hataların giderilmesi ve uygulamanın geliştirilmesi gibi amaçlarla kullanılabilir."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 10 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="10. Kişisel Verilerin Paylaşılması"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Kullanıcıların kişisel bilgilerinin izinsiz şekilde üçüncü kişilere satılması temel hizmet modelimizin bir parçası değildir. Veriler; hizmetin çalışması için gerekli teknik sağlayıcılarla, hukuki yükümlülüklerin yerine getirilmesi gereken durumlarda yetkili kurumlarla veya kullanıcının açıkça izin verdiği durumlarda paylaşılabilir."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 11 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="11. Üçüncü Taraf Hizmetleri"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Uygulama; sunucu, harita, hava durumu, bildirim, ödeme, analiz veya yapay zekâ gibi özellikler için üçüncü taraf hizmetlerinden yararlanabilir. Bu hizmetler yalnızca gerçekten kullanılmaya başlandıklarında kendi veri işleme politikalarına tabi olabilir. Kullanılan üçüncü taraf hizmetleri değiştikçe Gizlilik Politikası güncellenebilir."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 12 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="12. Veri Güvenliği"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Kullanıcı verilerinin yetkisiz erişim, değiştirme veya kayıp risklerine karşı korunması amacıyla uygulamanın teknik yapısına uygun güvenlik önlemleri alınması hedeflenir. Bununla birlikte internet üzerinden çalışan hiçbir sistem için mutlak güvenlik garantisi verilemez."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 13 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="13. Verilerin Saklanması"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Kullanıcı verileri, ilgili hizmetin sunulması için gerekli olduğu süre boyunca veya yürürlükteki mevzuatın gerektirdiği süreler dahilinde saklanabilir. Saklama süresi sona eren ve tutulması için başka bir hukuki neden bulunmayan veriler silinebilir, anonim hale getirilebilir veya güvenli şekilde erişilemez duruma getirilebilir."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 14 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="14. Hesap ve Verilerin Silinmesi"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Kullanıcı, uygulamanın sunduğu hesap yönetimi seçenekleri üzerinden hesabının veya uygun olduğu ölçüde kendisine ait kayıtların silinmesini talep edebilir. Silme işleminden sonra yasal olarak saklanması zorunlu olmayan kişisel verilerin kaldırılması hedeflenir. Daha önce anonim istatistiğe dönüştürülmüş ve kişiyi doğrudan tanımlamayan veriler ayrı değerlendirilebilir."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 15 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="15. Kullanıcının Hakları"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Kullanıcılar, yürürlükteki kişisel verilerin korunmasına ilişkin mevzuat kapsamında kendileriyle ilgili kişisel verilerin işlenip işlenmediğini öğrenme, bilgi talep etme, yanlış veya eksik bilgilerin düzeltilmesini isteme ve şartları oluştuğunda silinmesini veya yok edilmesini talep etme gibi haklara sahip olabilir."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 16 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="16. Çocukların Gizliliği"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Zeytin Defteri esas olarak tarımsal üretim ve işletme kayıtlarını takip etmek isteyen kullanıcılar için tasarlanmıştır. Çocuklara yönelik özel bir kişisel veri toplama amacı bulunmamaktadır. Yaşa bağlı özel yasal gereklilikler söz konusu olduğunda ilgili mevzuata uygun hareket edilmesi hedeflenir."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 17 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="17. Yapay Zekâ Özellikleri"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Uygulamaya ileride yapay zekâ destekli özellikler eklenmesi halinde, bu özelliklerin hangi verileri kullandığı ve verilerin cihaz üzerinde mi yoksa harici bir hizmet aracılığıyla mı işlendiği kullanıcıya uygun şekilde açıklanacaktır. Yapay zekâ özelliği kullanılmıyorsa bu madde herhangi bir ek veri toplandığı anlamına gelmez."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 18 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="18. Gizlilik Politikasındaki Değişiklikler"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Bu Gizlilik Politikası; uygulamaya yeni özellikler eklenmesi, veri işleme yöntemlerinin değişmesi veya yasal gereklilikler nedeniyle zaman zaman güncellenebilir. Önemli değişikliklerde kullanıcıların uygulama içerisinden veya uygun başka yöntemlerle bilgilendirilmesi amaçlanır."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- 19 -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="19. İletişim"
            android:textColor="@color/zd_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Gizlilik Politikası veya kişisel verilerinizle ilgili sorularınız ve talepleriniz için uygulama içerisinde sağlanacak iletişim kanallarını kullanabilirsiniz. Resmî destek ve iletişim bilgileri uygulama yayına alınmadan önce bu bölümde ayrıca belirtilecektir."
            android:textColor="@color/zd_muted"
            android:textSize="15sp" />


        <!-- ================================================= -->
        <!-- ALT AYIRICI                                       -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="30dp"
            android:background="@color/zd_border" />


        <!-- ================================================= -->
        <!-- ALT BİLGİ                                         -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="🌿 Zeytin Defteri"
            android:textColor="@color/zd_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Bahçenin hafızası cebinde."
            android:textColor="@color/zd_muted"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>